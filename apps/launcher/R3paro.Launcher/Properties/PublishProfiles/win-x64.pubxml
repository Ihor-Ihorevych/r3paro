<?xml version="1.0" encoding="utf-8"?>
<!-- Release build for the Windows zip: one self-contained, trimmed r3paro-launcher.exe (players install nothing).
     dotnet publish R3paro.Launcher -p:PublishProfile=win-x64 -o <dir> -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- a trimming warning means code may be missing at run time: fail the build instead -->
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
